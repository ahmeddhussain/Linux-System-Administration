#!/usr/bin/env bash
# Managed by Ansible (role: util_storage). Backs up util01's data to S3 (D-056).
#   ahmed-backup            back up homes and logs to the "latest" object
#   ahmed-backup restore    restore the latest backup (used on a new volume)
#   ahmed-backup verify     download the latest backup and read it end to end
# Owners are stored and restored by name, not number: a rebuilt IPA gives
# users and groups new numeric IDs (2026-11-02), and names map them back.
set -euo pipefail
export AWS_DEFAULT_REGION={{ util_backup_region }}
account="$(aws sts get-caller-identity --query Account --output text)"
target="s3://{{ util_backup_bucket_prefix }}-${account}/{{ util_backup_key }}"
dirs=({% for v in util_storage_volumes.values() %}{{ v.mount | regex_replace('^/', '') }} {% endfor %})

case "${1:-backup}" in
  backup)
    start=$(date +%s)
    # .nfs* files are NFS "silly renames": files deleted while a client still
    # has them open. They are already gone for the user, and util01 cannot
    # open them while they are locked (backup failure, 2026-11-02).
    tar --create --gzip --acls --xattrs --selinux --exclude='.nfs*' -C / "${dirs[@]}" \
      | aws s3 cp --only-show-errors - "$target"
    logger -t ahmed-backup "backup to $target done in $(( $(date +%s) - start ))s"
    ;;
  restore)
    bucket="${target#s3://}"; bucket="${bucket%%/*}"
    if ! aws s3api head-object --bucket "$bucket" --key "{{ util_backup_key }}" > /dev/null 2>&1; then
      echo "no backup yet at $target"; exit 3
    fi
    start=$(date +%s)
    aws s3 cp --only-show-errors "$target" - \
      | tar --extract --gzip --acls --xattrs --selinux -C /
    echo "restored $target in $(( $(date +%s) - start ))s"
    ;;
  verify)
    aws s3 cp --only-show-errors "$target" - | tar --list --gzip > /dev/null
    echo "backup at $target is readable"
    ;;
  *) echo "usage: $0 [backup|restore|verify]" >&2; exit 2 ;;
esac

# Managed by Ansible (role: wireguard_gateway). Do not edit by hand.
# wg0 is bound to the trusted firewall zone permanently by the role,
# so this file does not touch the firewall.
[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_key.content | b64decode | trim }}
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }} ({{ peer.team }})
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}
{% endfor %}
<?xml version="1.0" encoding="utf-8"?>
<!-- Managed by Ansible (role: wireguard_gateway). Do not edit by hand. -->
<!-- Forwarding from team {{ item.key }}'s VPN range into the VPC (D-052). -->
<policy target="REJECT" priority="-10">
  <short>vpn-{{ item.key }}-to-vpc</short>
  <ingress-zone name="vpn-{{ item.key }}"/>
  <egress-zone name="public"/>
{% for a in item.value.allow %}
  <rule family="ipv4">
    <destination address="{{ hostvars[a.host].ansible_host }}/32"/>
    <port port="{{ a.port }}" protocol="tcp"/>
    <accept/>
  </rule>
{% endfor %}
{% if item.value.ping | default(false) %}
{% for h in item.value.allow | map(attribute='host') | unique %}
  <rule family="ipv4">
    <destination address="{{ hostvars[h].ansible_host }}/32"/>
    <icmp-type name="echo-request"/>
    <accept/>
  </rule>
{% endfor %}
{% endif %}
</policy>

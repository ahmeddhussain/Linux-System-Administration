# Managed by Ansible (role: wireguard_gateway). Do not edit by hand.
[Unit]
Description=wstunnel server: WireGuard carried inside TLS on TCP {{ wstunnel_port }}
After=network-online.target wg-quick@{{ wireguard_interface }}.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wstunnel server wss://0.0.0.0:{{ wstunnel_port }} --restrict-to localhost:{{ wireguard_port }}
# Runs as a throwaway unprivileged user that may only bind low ports.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
# Managed by Ansible (role: log_server). Central log server on util01 (D-059).
# Accepts TLS only, from senders with a valid certificate of the IPA CA.
# The host directory comes from the sender's address (reverse DNS in IPA),
# not from the hostname inside the message, so a host cannot write into
# another host's directory.
module(load="imtcp"
  StreamDriver.Name="ossl" StreamDriver.Mode="1" StreamDriver.AuthMode="x509/certvalid")

template(name="ahmed_per_host" type="string"
  string="{{ log_dir }}/%FROMHOST%/%PROGRAMNAME:::secpath-replace%.log")

# Audit records (D-063) are stored as raw audit lines, without a syslog
# header, so "ausearch -if" and "aureport -if" read the file directly. The
# plugin's own status lines (no "type=") go to audisp-syslog.log instead.
template(name="ahmed_audit_per_host" type="string"
  string="{{ log_dir }}/%FROMHOST%/audit.log")
template(name="ahmed_audit_raw" type="string" string="%$!audit%\n")

ruleset(name="ahmed_remote") {
  if $programname == "audisp-syslog" and $msg contains "type=" then {
    set $!audit = ltrim($msg);
    action(type="omfile" dynaFile="ahmed_audit_per_host" template="ahmed_audit_raw"
      createDirs="on" dirCreateMode="0750" fileCreateMode="0640"
      dirGroup="{{ log_reader_group }}" fileGroup="{{ log_reader_group }}")
    stop
  }
  action(type="omfile" dynaFile="ahmed_per_host" createDirs="on"
    dirCreateMode="0750" fileCreateMode="0640"
    dirGroup="{{ log_reader_group }}" fileGroup="{{ log_reader_group }}")
  stop
}

input(type="imtcp" port="{{ log_server_port }}" ruleset="ahmed_remote")
